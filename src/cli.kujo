from src.audit import audit_start, audit_input, audit_detections, audit_decisions, audit_transformations, audit_verify, audit_output, audit_pack_publication, audit_warnings
from src.detect import detect_document
from src.document import MAX_OUTPUT_BYTES, load_document, validate_output_content, validate_output_path
from src.policy import load_policy
from src.transform import transform_document
from src.util import content_hash, ensure_dir, get_or, normalize_cli_path, parent_of, path_has_symlink_component, path_has_traversal, truthy, validate_directory_target
from src.verify import verify_document
from src.version import CLI_SCHEMA_VERSION, PRODUCT_VERSION

export func main(argv) {
    if len(argv) == 0 {
        print_help()
        return 2
    }
    command := argv[0]
    if command == "--help"||command == "help" {
        print_help()
        return 0
    }
    if command == "version" {
        print("redact " + PRODUCT_VERSION)
        return 0
    }
    if known_command(command) == false {
        print("ERROR: unknown command: " + command)
        return 2
    }
    parsed := parse_args(slice_from(argv, 1))
    if parsed["ok"] == false {
        print("ERROR: " + parsed["error"])
        return 2
    }
    pos := parsed["positionals"]
    if len(pos) < 1 {
        print("ERROR: missing input path")
        return 2
    }
    if len(pos) > 1 {
        print("ERROR: unexpected positional argument: " + pos[1])
        return 2
    }
    args_check := validate_command_args(command, parsed)
    if args_check["ok"] == false {
        print("ERROR: " + args_check["error"])
        return 2
    }
    input_path := normalize_cli_path(pos[0])
    policy_ref := normalize_cli_path(flag(parsed, "policy", "basic"))
    loaded_policy := load_policy(policy_ref)
    if loaded_policy["ok"] == false {
        print("ERROR: " + loaded_policy["error"])
        return 1
    }
    policy := loaded_policy["policy"]
    audit_dir := normalize_cli_path(flag(parsed, "audit-dir", ".redact"))
    audit_path_check := validate_directory_target(audit_dir, "audit directory")
    if audit_path_check["ok"] == false {
        print("ERROR: " + audit_path_check["error"])
        return 1
    }
    unsafe := truthy(get_or(parsed["flags"], "unsafe-store-originals", false))

    if command == "scan" {
        return cmd_scan(input_path, policy, audit_dir, unsafe)
    }
    if command == "sanitize" {
        return cmd_sanitize(input_path, policy, audit_dir, parsed, unsafe, true)
    }
    if command == "verify" {
        if unsafe {
            print("ERROR: --unsafe-store-originals is only valid for scan, sanitize, and pack")
            return 2
        }
        return cmd_verify(input_path, policy, audit_dir)
    }
    if command == "pack" {
        return cmd_pack(input_path, policy, audit_dir, parsed, unsafe)
    }
    return 2
}

func cmd_scan(input_path, policy, audit_dir, unsafe) {
    doc_res := load_document(input_path)
    if doc_res["ok"] == false {
        print("ERROR: " + doc_res["error"])
        return 1
    }
    doc := doc_res["document"]
    audit := audit_start(audit_dir, "scan", input_path, policy, unsafe)
    if audit["ok"] == false {
        print("ERROR: " + audit["error"])
        return 1
    }
    audit_input(audit["run_dir"], doc)
    det := detect_document(doc, policy)
    if det["ok"] == false {
        print("ERROR: " + det["error"])
        return 1
    }
    audit_detections(audit["run_dir"], det["detections"], unsafe)
    summary := {
        "schemaVersion": CLI_SCHEMA_VERSION,
        "productVersion": PRODUCT_VERSION,
        "command": "scan",
        "input": input_path,
        "policy": policy["name"],
        "detections": len(det["detections"]),
        "categories": category_counts(det["detections"]),
        "audit_dir": audit["run_dir"],
        "unsafeOriginalsStored": unsafe
    }
    print(to_json_pretty(summary))
    return 0
}

func cmd_sanitize(input_path, policy, audit_dir, parsed, unsafe, emit_output) {
    doc_res := load_document(input_path)
    if doc_res["ok"] == false {
        print("ERROR: " + doc_res["error"])
        return 1
    }
    doc := doc_res["document"]
    out_path := normalize_cli_path(flag(parsed, "out", default_output_path(input_path)))
    output_check := validate_output_path(input_path, out_path)
    if output_check["ok"] == false {
        print("ERROR: " + output_check["error"])
        return 1
    }
    audit := audit_start(audit_dir, "sanitize", input_path, policy, unsafe)
    if audit["ok"] == false {
        print("ERROR: " + audit["error"])
        return 1
    }
    audit_input(audit["run_dir"], doc)
    det := detect_document(doc, policy)
    if det["ok"] == false {
        print("ERROR: " + det["error"])
        return 1
    }
    audit_detections(audit["run_dir"], det["detections"], unsafe)
    transformed := transform_document(doc, det["detections"], policy)
    if transformed["ok"] == false {
        print("ERROR: " + transformed["error"])
        return 1
    }
    out_doc := transformed["document"]
    output_content_check := validate_output_content(out_doc["content"])
    if output_content_check["ok"] == false {
        print("ERROR: " + output_content_check["error"])
        return 1
    }
    report := verify_document(out_doc, policy)
    if has_key(report, "ok")&&report["ok"] == false {
        print("ERROR: " + report["error"])
        return 1
    }
    parent := parent_of(out_path)
    if parent != "" {ensure_dir(parent)}
    write_file_atomic(out_path, out_doc["content"], true)
    audit_decisions(audit["run_dir"], transformed["decisions"])
    audit_transformations(audit["run_dir"], transformed["transformations"])
    audit_verify(audit["run_dir"], report)
    if emit_output {
        audit_output(audit["run_dir"], out_path, out_doc["content"])
    }
    audit_warnings(audit["run_dir"], report["warnings"])
    summary := {
        "schemaVersion": CLI_SCHEMA_VERSION,
        "productVersion": PRODUCT_VERSION,
        "command": "sanitize",
        "input": input_path,
        "output": out_path,
        "policy": policy["name"],
        "detections": len(det["detections"]),
        "risk_score": report["risk_score"],
        "audit_dir": audit["run_dir"],
        "unsafeOriginalsStored": unsafe
    }
    if emit_output {
        print(to_json_pretty(summary))
    }
    if should_fail_for_risk(report["risk_score"], flag(parsed, "fail-on-risk", "")) {
        return 1
    }
    if emit_output == false {
        return {"ok": true, "run_dir": audit["run_dir"]}
    }
    return 0
}

func cmd_verify(input_path, policy, audit_dir) {
    doc_res := load_document(input_path)
    if doc_res["ok"] == false {
        print("ERROR: " + doc_res["error"])
        return 1
    }
    doc := doc_res["document"]
    audit := audit_start(audit_dir, "verify", input_path, policy, false)
    if audit["ok"] == false {
        print("ERROR: " + audit["error"])
        return 1
    }
    audit_input(audit["run_dir"], doc)
    report := verify_document(doc, policy)
    if has_key(report, "ok")&&report["ok"] == false {
        print("ERROR: " + report["error"])
        return 1
    }
    audit_verify(audit["run_dir"], report)
    audit_warnings(audit["run_dir"], report["warnings"])
    print(to_json_pretty(report))
    if report["risk_score"] == "high" {
        return 1
    }
    return 0
}

func cmd_pack(folder, policy, audit_dir, parsed, unsafe) {
    if path_has_traversal(folder) {
        print("ERROR: pack input must not contain path traversal segments: " + folder)
        return 1
    }
    if path_has_symlink_component(folder) {
        print("ERROR: pack input must not contain symbolic links: " + folder)
        return 1
    }
    if path_is_dir(folder) == false {
        print("ERROR: pack input is not a folder: " + folder)
        return 1
    }
    out_dir := normalize_cli_path(flag(parsed, "out", "redact-pack"))
    out_check := validate_directory_target(out_dir, "pack output directory")
    if out_check["ok"] == false {
        print("ERROR: " + out_check["error"])
        return 1
    }
    if path_exists(out_dir) {
        print("ERROR: pack output directory already exists; choose a new path: " + out_dir)
        return 1
    }
    if out_dir == folder {
        print("ERROR: pack output directory must differ from the input folder")
        return 1
    }
    files := list_dir(folder)
    files = sort(files)
    // Validate every eligible member before creating or populating the pack.
    // cmd_sanitize reloads each file so its normal checks still apply at use time.
    mut eligible := 0
    mut index := 0
    while index < len(files) {
        name := files[index]
        path := folder + "/" + name
        if ends_with(to_lower(name), ".md")||ends_with(to_lower(name), ".txt") {
            if path_has_symlink_component(path) {
                print("ERROR: pack member must not contain symbolic links: " + path)
                return 1
            }
            if path_is_dir(path) {
                index = index + 1
                continue
            }
            checked := load_document(path)
            if checked["ok"] == false {
                print("ERROR: pack member " + name + ": " + checked["error"])
                return 1
            }
            eligible = eligible + 1
        }
        index = index + 1
    }
    if eligible == 0 {
        print("ERROR: pack input contains no supported .txt or .md files")
        return 1
    }
    parent := parent_of(out_dir)
    if parent == "" {parent = "."}
    ensure_dir(parent)
    stage := ""
    try {
        stage = create_temp_dir(parent, ".redact-pack-")
    } except err {
        print("ERROR: cannot create private pack staging directory")
        return 1
    }
    if stage == ""||path_has_symlink_component(stage) {
        print("ERROR: unsafe pack staging directory")
        return 1
    }
    mut processed := 0
    mut failed := 0
    mut staged_names := []
    mut audit_runs := []
    mut i := 0
    while i < len(files) {
        name := files[i]
        path := folder + "/" + name
        if path_is_dir(path) == false&&(ends_with(to_lower(name), ".md")||ends_with(to_lower(name), ".txt")) {
            out_path := stage + "/" + name
            local := {"flags": {"out": out_path}, "positionals": [path]}
            result := 1
            try {
                result = cmd_sanitize(path, policy, audit_dir, local, unsafe, false)
            } except err {
                print("ERROR: pack member could not be processed: " + name)
            }
            if type(result) == "dict"&&result["ok"] {
                processed = processed + 1
                staged_names = push(staged_names, name)
                audit_runs = push(audit_runs, result["run_dir"])
            } else {
                failed = failed + 1
            }
        }
        i = i + 1
    }
    if failed > 0 {
        cleanup_pack_stage(stage, files)
        print(to_json_pretty({
            "schemaVersion": CLI_SCHEMA_VERSION,
            "productVersion": PRODUCT_VERSION,
            "command": "pack",
            "input": folder,
            "output": out_dir,
            "processed": 0,
            "staged": processed,
            "failed": failed,
            "published": false,
            "error": "pack failed; no output directory was published"
        }))
        return 1
    }
    mut staged_hashes := []
    i = 0
    while i < len(staged_names) {
        final_path := out_dir + "/" + staged_names[i]
        mut intent_ok := true
        try {
            content := read_file_beneath(stage, staged_names[i], MAX_OUTPUT_BYTES)
            staged_hashes = push(staged_hashes, audit_pack_publication(audit_runs[i], final_path, content, "pending"))
        } except err {
            intent_ok = false
        }
        if intent_ok == false {
            cleanup_pack_stage(stage, files)
            print("ERROR: cannot record pack audit intent; no output directory was published")
            return 1
        }
        i = i + 1
    }
    mut published := false
    try {
        published = publish_directory_noreplace(stage, out_dir)
    } except err {
        published = false
    }
    if published == false {
        cleanup_pack_stage(stage, files)
        print("ERROR: pack output directory appeared or publication failed: " + out_dir)
        return 1
    }
    i = 0
    mut audit_failed := 0
    while i < len(staged_names) {
        final_path := out_dir + "/" + staged_names[i]
        try {
            content := read_file_beneath(out_dir, staged_names[i], MAX_OUTPUT_BYTES)
            if content_hash(content) != staged_hashes[i] {
                audit_failed = audit_failed + 1
            } else {
                audit_output(audit_runs[i], final_path, content)
                audit_pack_publication(audit_runs[i], final_path, content, "published")
            }
        } except err {
            audit_failed = audit_failed + 1
        }
        i = i + 1
    }
    print(to_json_pretty({
        "schemaVersion": CLI_SCHEMA_VERSION,
        "productVersion": PRODUCT_VERSION,
        "command": "pack",
        "input": folder,
        "output": out_dir,
        "processed": processed,
        "failed": failed,
        "published": true,
        "auditComplete": audit_failed == 0,
        "auditFailed": audit_failed,
        "unsafeOriginalsStored": unsafe
    }))
    if audit_failed > 0 {return 1}
    return 0
}

func cleanup_pack_stage(stage, names) {
    if path_has_symlink_component(stage) {return}
    mut i := 0
    while i < len(names) {
        name := names[i]
        if ends_with(to_lower(name), ".md")||ends_with(to_lower(name), ".txt") {
            path := stage + "/" + name
            if path_exists(path)&&path_is_dir(path) == false {
                try {delete_file(path)} except err {}
            }
        }
        i = i + 1
    }
    try {os_rmdir(stage)} except err {}
}

func parse_args(tokens) {
    mut positionals := []
    mut flags := {}
    mut i := 0
    while i < len(tokens) {
        tok := tokens[i]
        if starts_with(tok, "--") {
            key := substring(tok, 2, len(tok))
            if known_flag(key) == false {
                return {"ok": false, "error": "unknown option: --" + key}
            }
            if has_key(flags, key) == 1 {
                return {"ok": false, "error": "duplicate option: --" + key}
            }
            if key == "unsafe-store-originals" {
                flags[key] := true
            } else if i + 1 < len(tokens)&&starts_with(tokens[i + 1], "--") == false {
                flags[key] := tokens[i + 1]
                i = i + 1
            } else {
                return {"ok": false, "error": "option requires a value: --" + key}
            }
        } else {
            positionals = push(positionals, tok)
        }
        i = i + 1
    }
    return {"ok": true, "positionals": positionals, "flags": flags}
}

func known_command(command) {
    return command == "scan"||command == "sanitize"||command == "verify"||command == "pack"
}

func known_flag(key) {
    return key == "policy"||key == "audit-dir"||key == "out"||key == "fail-on-risk"||key == "unsafe-store-originals"
}

func command_allows_flag(command, key) {
    if key == "policy"||key == "audit-dir" {
        return true
    }
    if key == "unsafe-store-originals" {
        return command == "scan"||command == "sanitize"||command == "pack"
    }
    if key == "out" {
        return command == "sanitize"||command == "pack"
    }
    if key == "fail-on-risk" {
        return command == "sanitize"
    }
    return false
}

func validate_command_args(command, parsed) {
    names := keys(parsed["flags"])
    mut i := 0
    while i < len(names) {
        key := names[i]
        if command_allows_flag(command, key) == false {
            if key == "unsafe-store-originals" {
                return {"ok": false, "error": "--unsafe-store-originals is only valid for scan, sanitize, and pack"}
            }
            return {"ok": false, "error": "option --" + key + " is not valid for " + command}
        }
        i = i + 1
    }
    threshold := flag(parsed, "fail-on-risk", "")
    if threshold != ""&&threshold != "medium"&&threshold != "high" {
        return {"ok": false, "error": "--fail-on-risk must be medium or high"}
    }
    return {"ok": true}
}

func slice_from(arr, start) {
    mut out := []
    mut i := start
    while i < len(arr) {
        out = push(out, arr[i])
        i = i + 1
    }
    return out
}

func flag(parsed, name, fallback) {
    return get_or(parsed["flags"], name, fallback)
}

func default_output_path(input_path) {
    if ends_with(input_path, ".md") {
        return substring(input_path, 0, len(input_path) - 3) + ".redacted.md"
    }
    if ends_with(input_path, ".txt") {
        return substring(input_path, 0, len(input_path) - 4) + ".redacted.txt"
    }
    return input_path + ".redacted"
}

func category_counts(detections) {
    mut counts := {}
    mut i := 0
    while i < len(detections) {
        cat := detections[i]["category"]
        if has_key(counts, cat) == 1 {
            counts[cat] := counts[cat] + 1
        } else {
            counts[cat] := 1
        }
        i = i + 1
    }
    return counts
}

func should_fail_for_risk(score, threshold) {
    if threshold == "" {
        return false
    }
    return risk_rank(score) >= risk_rank(threshold)
}

func risk_rank(score) {
    if score == "low" {return 1}
    if score == "medium" {return 2}
    if score == "high" {return 3}
    if score == "incomplete" {return 4}
    return 0
}

func print_help() {
    print("Redact " + PRODUCT_VERSION + " — local-first deterministic redaction aid")
    print("")
    print("Usage:")
    print("  kujo run redact.kujo scan <input> --policy <policy>")
    print("  kujo run redact.kujo sanitize <input> --policy <policy> [--out <path>]")
    print("  kujo run redact.kujo verify <input> --policy <policy>")
    print("  kujo run redact.kujo pack <folder> --policy <policy> [--out <dir>]")
    print("")
    print("Inputs: local .txt and .md files only; '-' stdin is not supported in 1.0")
    print("Options: --audit-dir <path> --fail-on-risk medium|high --unsafe-store-originals")
    print("DANGER: --unsafe-store-originals writes raw detections into an isolated audit run")
}
