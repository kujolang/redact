from src.policy import policy_terms
from src.util import value_hash, str_find_from, longest_first, only_digits

export func detect_document(doc, policy) {
    text := doc["content"]
    mut detections := []
    detections = append_regex(detections, text, "det.email", "emails", "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "placeholder", 0.99)
    detections = append_regex(detections, text, "det.api_key", "api_keys", "\\b(?:sk-[A-Za-z0-9_-]{16,}|[A-Za-z0-9_]*(?:TOKEN|KEY|SECRET)[A-Za-z0-9_]*=[A-Za-z0-9_./-]{8,})\\b", "remove", 0.9)
    detections = append_regex(detections, text, "det.url", "domains", "https?://[^\\s)>\"]+", "placeholder", 0.92)
    detections = append_regex(detections, text, "det.domain", "domains", "\\b[A-Za-z0-9.-]+\\.(?:com|net|org|io|ai|dev|app|co|video)\\b", "placeholder", 0.9)
    detections = append_money(detections, text)
    detections = append_dates(detections, text)
    detections = append_credit_cards(detections, text)
    detections = append_phones(detections, text)
    // ASCII matching can use native literal search over one lowercased document.
    // Keep the candidate-based path for Unicode: contextual lowercase (notably
    // Greek final sigma) is not equivalent to lowercasing the whole document.
    mut low_text := ""
    categories := ["person_names", "company_names", "customer_names", "product_names", "launch_strategy"]
    mut term_work := 0
    mut unicode_term_work := 0
    mut has_terms := false
    mut c := 0
    while c < len(categories) {
        candidate_terms := policy_terms(policy, categories[c])
        if len(candidate_terms) > 0 {has_terms = true}
        mut t := 0
        while t < len(candidate_terms) {
            term_work = term_work + len(candidate_terms[t])
            if byte_length(candidate_terms[t]) != len(candidate_terms[t]) {
                unicode_term_work = unicode_term_work + len(candidate_terms[t])
            }
            t = t + 1
        }
        c = c + 1
    }
    if byte_length(text) != len(text)&&len(text) * term_work > 2000000 {
        return {"ok": false, "error": "configured Unicode dictionary work exceeds the 2000000-candidate budget"}
    }
    if byte_length(text) == len(text)&&len(text) * unicode_term_work > 2000000 {
        return {"ok": false, "error": "configured Unicode dictionary work exceeds the 2000000-candidate budget"}
    }
    if has_terms {
        if byte_length(text) == len(text) {low_text = to_lower(text)}
    }
    detections = append_terms(detections, text, low_text, policy_terms(policy, "person_names"), "dictionary.person", "person_names", "role-preserve")
    detections = append_terms(detections, text, low_text, policy_terms(policy, "company_names"), "dictionary.company", "company_names", "placeholder")
    detections = append_terms(detections, text, low_text, policy_terms(policy, "customer_names"), "dictionary.customer", "customer_names", "placeholder")
    detections = append_terms(detections, text, low_text, policy_terms(policy, "product_names"), "dictionary.product", "product_names", "placeholder")
    detections = append_terms(detections, text, low_text, policy_terms(policy, "launch_strategy"), "dictionary.strategy", "launch_strategy", "generalize")
    return {"ok": true, "detections": detections}
}

func append_phones(detections, text) {
    pattern := "(?:\\+[0-9][0-9 .()\\-]{8,}[0-9]|\\b[0-9][0-9 .()\\-]{8,}[0-9]\\b)"
    matches := regex_find_all(text, pattern)
    if len(matches) == 0 {return detections}
    parts := regex_split(text, pattern)
    mut out := detections
    mut seen := {}
    mut start := len(parts[0])
    mut i := 0
    while i < len(matches) {
        value := matches[i]
        digits := only_digits(value)
        if len(digits) >= 10&&len(digits) <= 15&&has_key(seen, value) == 0 {
            out = push(out, detection("det.phone", "phone_numbers", start, start + len(value), value, 0.86, "deterministic phone pattern match", "remove"))
            seen[value] := true
        }
        start = start + len(value) + len(parts[i + 1])
        i = i + 1
    }
    return out
}

func append_terms(detections, text, low_text, terms, detector_id, category, suggested_action) {
    mut out := detections
    mut seen := {}
    ordered_terms := longest_first(terms, "")
    mut i := 0
    while i < len(ordered_terms) {
        term := ordered_terms[i]
        if low_text != ""&&byte_length(term) == len(term) {
            low_term := to_lower(term)
            if index_of(low_text, low_term) < 0 {
                i = i + 1
                continue
            }
            // Native split supplies scalar offsets, and native regex supplies
            // original case variants; avoid repeatedly copying the 1 MiB
            // document to find each occurrence of a frequent ASCII term.
            parts := split(low_text, low_term)
            variants := regex_find_all(text, "(?i)" + regex_literal_ascii(term))
            if len(variants) == len(parts) - 1 {
                mut position := len(parts[0])
                mut v := 0
                while v < len(variants) {
                    value := variants[v]
                    if has_key(seen, value) == 0 {
                        out = push(out, detection(detector_id, category, position, position + len(value), value, 1.0, "configured sensitive term", suggested_action))
                        seen[value] := true
                    }
                    position = position + len(value) + len(parts[v + 1])
                    v = v + 1
                }
                i = i + 1
                continue
            }
        }
        mut start_at := 0
        mut found := find_term_from(text, low_text, term, start_at)
        while found["value"] != "" {
            value := found["value"]
            if has_key(seen, value) == 0 {
                start := found["start"]
                out = push(out, detection(detector_id, category, start, start + len(value), value, 1.0, "configured sensitive term", suggested_action))
                seen[value] := true
            }
            start_at = found["start"] + len(value)
            found = find_term_from(text, low_text, term, start_at)
        }
        i = i + 1
    }
    return out
}

export func regex_literal_ascii(value) {
    return regex_replace(value, "([.\\\\+*?\\[\\](){}^$|])", "\\$1")
}

func find_term_from(text, low_text, term, start_at) {
    if low_text != ""&&byte_length(term) == len(term) {
        low_term := to_lower(term)
        start :=  - 1
        if start_at == 0 {
            start = index_of(low_text, low_term)
        } else {
            start = str_find_from(low_text, low_term, start_at)
        }
        if start < 0 {return {"value": "", "start": - 1}}
        return {"value": substring(text, start, start + len(term)), "start": start}
    }
    if low_text != "" {
        // Some Unicode terms lowercase to ASCII (for example Kelvin sign),
        // so an ASCII document still needs the contextual fallback here.
        return find_case_variant_from(text, term, start_at)
    }
    return find_case_variant_from(text, term, start_at)
}

func find_case_variant_from(text, term, start_at) {
    if term == "" {
        return {"value": "", "start": - 1}
    }
    low_term := to_lower(term)
    n := len(term)
    // Bound the live character array to one window. Overlap by n-1 scalars
    // so contextual lowercase at a window boundary sees the full candidate.
    mut base := start_at
    mut total := len(text)
    while base < total {
        count := 65536
        if total - base < count {count = total - base}
        window := substring(text, base, base + count + n - 1)
        chars := regex_find_all(window, "(?s).")
        mut i := 0
        while i < count {
            candidate := join(slice(chars, i, i + n), "")
            if to_lower(candidate) == low_term {
                return {"value": candidate, "start": base + i}
            }
            i = i + 1
        }
        base = base + count
    }
    return {"value": "", "start": - 1}
}

func append_regex(detections, text, detector_id, category, pattern, suggested_action, confidence) {
    matches := regex_find_all(text, pattern)
    if len(matches) == 0 {return detections}
    parts := regex_split(text, pattern)
    mut out := detections
    mut seen := {}
    mut start := len(parts[0])
    mut i := 0
    while i < len(matches) {
        value := matches[i]
        if value != ""&&has_key(seen, value) == 0 {
            out = push(out, detection(detector_id, category, start, start + len(value), value, confidence, "deterministic pattern match", suggested_action))
            seen[value] := true
        }
        start = start + len(value) + len(parts[i + 1])
        i = i + 1
    }
    return out
}

func append_money(detections, text) {
    return append_regex(detections, text, "det.money", "money_amounts", "\\$[0-9][0-9,]*(?:\\.[0-9]{2})?\\b", "range", 0.88)
}

func append_dates(detections, text) {
    mut out := detections
    out = append_regex(out, text, "det.date.iso", "exact_dates", "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}(?::[0-9]{2})?Z?)?\\b", "date-generalize", 0.93)
    out = append_regex(out, text, "det.date.named", "exact_dates", "\\b(?:January|February|March|April|May|June|July|August|September|October|November|December) [0-9]{1,2}, [0-9]{4}\\b", "date-generalize", 0.91)
    return out
}

func append_credit_cards(detections, text) {
    pattern := "\\b[0-9][0-9 -]{12,22}[0-9]\\b"
    matches := regex_find_all(text, pattern)
    if len(matches) == 0 {return detections}
    parts := regex_split(text, pattern)
    mut out := detections
    mut seen := {}
    mut start := len(parts[0])
    mut i := 0
    while i < len(matches) {
        value := matches[i]
        digits := only_digits(value)
        if len(digits) >= 13&&len(digits) <= 19&&luhn_valid(digits)&&has_key(seen, value) == 0 {
            out = push(out, detection("det.credit_card.luhn", "payment_details", start, start + len(value), value, 0.99, "credit card candidate passed Luhn validation", "remove"))
            seen[value] := true
        }
        start = start + len(value) + len(parts[i + 1])
        i = i + 1
    }
    return out
}

func detection(detector_id, category, start, end, value, confidence, reason, suggested_action) {
    return {
        "detector_id": detector_id,
        "category": category,
        "span_start": start,
        "span_end": end,
        "matched_value_hash": value_hash(value),
        "confidence": confidence,
        "reason": reason,
        "suggested_action": suggested_action,
        "value": value
    }
}

func digit_value(ch) {
    if ch == "0" {return 0}
    if ch == "1" {return 1}
    if ch == "2" {return 2}
    if ch == "3" {return 3}
    if ch == "4" {return 4}
    if ch == "5" {return 5}
    if ch == "6" {return 6}
    if ch == "7" {return 7}
    if ch == "8" {return 8}
    if ch == "9" {return 9}
    return 0
}

func luhn_valid(digits) {
    mut sum := 0
    mut alt := false
    mut i := len(digits) - 1
    while i >= 0 {
        d := digit_value(substring(digits, i, i + 1))
        if alt {
            d = d * 2
            if d > 9 {
                d = d - 9
            }
        }
        sum = sum + d
        alt = alt == false
        i = i - 1
    }
    return sum % 10 == 0
}
