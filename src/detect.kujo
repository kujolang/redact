from src.policy import policy_terms
from src.util import value_hash, str_find

export func detect_document(doc, policy) {
    text := doc["content"]
    mut detections := []
    detections = append_regex(detections, text, "det.email", "emails", "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "placeholder", 0.99)
    detections = append_regex(detections, text, "det.api_key", "api_keys", "\\b(?:sk-[A-Za-z0-9_-]{16,}|[A-Za-z0-9_]*(?:TOKEN|KEY|SECRET)[A-Za-z0-9_]*=[A-Za-z0-9_./-]{8,})\\b", "remove", 0.9)
    detections = append_regex(detections, text, "det.url", "domains", "https?://[^\\s)>\"]+", "placeholder", 0.92)
    detections = append_regex(detections, text, "det.domain", "domains", "\\b[A-Za-z0-9.-]+\\.(?:com|net|org|io|ai|dev|app|co|video)\\b", "placeholder", 0.9)
    detections = append_money(detections, text)
    detections = append_dates(detections, text)
    detections = append_credit_cards(detections, text)
    detections = append_phones(detections, text)
    detections = append_terms(detections, text, policy_terms(policy, "person_names"), "dictionary.person", "person_names", "role-preserve")
    detections = append_terms(detections, text, policy_terms(policy, "company_names"), "dictionary.company", "company_names", "placeholder")
    detections = append_terms(detections, text, policy_terms(policy, "customer_names"), "dictionary.customer", "customer_names", "placeholder")
    detections = append_terms(detections, text, policy_terms(policy, "product_names"), "dictionary.product", "product_names", "placeholder")
    detections = append_terms(detections, text, policy_terms(policy, "launch_strategy"), "dictionary.strategy", "launch_strategy", "generalize")
    return {"ok": true, "detections": detections}
}

func append_phones(detections, text) {
    matches := regex_find_all(text, "(?:\\+[0-9][0-9 .()\\-]{8,}[0-9]|\\b[0-9][0-9 .()\\-]{8,}[0-9]\\b)")
    mut out := detections
    mut seen := []
    mut i := 0
    while i < len(matches) {
        value := matches[i]
        digits := only_digits(value)
        if len(digits) >= 10&&len(digits) <= 15&&unique_seen(seen, value) == 0 {
            start := str_find(text, value)
            out = push(out, detection("det.phone", "phone_numbers", start, start + len(value), value, 0.86, "deterministic phone pattern match", "remove"))
            seen = push(seen, value)
        }
    i = i + 1
}
return out
}

func append_terms(detections, text, terms, detector_id, category, suggested_action) {
    mut out := detections
    mut seen := []
    ordered_terms := terms_longest_first(terms)
    mut i := 0
    while i < len(ordered_terms) {
        term := ordered_terms[i]
        mut start_at := 0
        mut found := find_case_variant_from(text, term, start_at)
        while found["value"] != "" {
            value := found["value"]
            if unique_seen(seen, value) == 0 {
                start := found["start"]
                out = push(out, detection(detector_id, category, start, start + len(value), value, 1.0, "configured sensitive term", suggested_action))
                seen = push(seen, value)
            }
        start_at = found["start"] + len(value)
        found = find_case_variant_from(text, term, start_at)
    }
i = i + 1
}
return out
}

func terms_longest_first(terms) {
    mut ordered := []
    mut used := []
    while len(ordered) < len(terms) {
        mut best :=  - 1
        mut best_len :=  - 1
        mut i := 0
        while i < len(terms) {
            if index_used(used, i) == false&&len(terms[i]) > best_len {
                best = i
                best_len = len(terms[i])
            }
        i = i + 1
    }
if best >= 0 {
    ordered = push(ordered, terms[best])
    used = push(used, best)
}
}
return ordered
}

func index_used(used, index) {
    mut i := 0
    while i < len(used) {
        if used[i] == index {
            return true
        }
    i = i + 1
}
return false
}

func find_case_variant_from(text, term, start_at) {
    if term == "" {
        return {"value": "", "start": - 1}
    }
low_term := to_lower(term)
n := len(term)
mut i := start_at
while substring(text, i, i + 1) != "" {
    candidate := substring(text, i, i + n)
    if to_lower(candidate) == low_term {
        return {"value": candidate, "start": i}
    }
i = i + 1
}
return {"value": "", "start": - 1}
}

func append_regex(detections, text, detector_id, category, pattern, suggested_action, confidence) {
    matches := regex_find_all(text, pattern)
    mut out := detections
    mut seen := []
    mut i := 0
    while i < len(matches) {
        value := matches[i]
        if value != ""&&unique_seen(seen, value) == 0 {
            start := str_find(text, value)
            out = push(out, detection(detector_id, category, start, start + len(value), value, confidence, "deterministic pattern match", suggested_action))
            seen = push(seen, value)
        }
    i = i + 1
}
return out
}

func append_money(detections, text) {
    return append_regex(detections, text, "det.money", "money_amounts", "\\$[0-9][0-9,]*(?:\\.[0-9]{2})?\\b", "range", 0.88)
}

func append_dates(detections, text) {
    mut out := detections
    out = append_regex(out, text, "det.date.iso", "exact_dates", "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}(?::[0-9]{2})?Z?)?\\b", "date-generalize", 0.93)
    out = append_regex(out, text, "det.date.named", "exact_dates", "\\b(?:January|February|March|April|May|June|July|August|September|October|November|December) [0-9]{1,2}, [0-9]{4}\\b", "date-generalize", 0.91)
    return out
}

func append_credit_cards(detections, text) {
    matches := regex_find_all(text, "\\b[0-9][0-9 -]{12,22}[0-9]\\b")
    mut out := detections
    mut seen := []
    mut i := 0
    while i < len(matches) {
        value := matches[i]
        digits := only_digits(value)
        if len(digits) >= 13&&len(digits) <= 19&&luhn_valid(digits)&&unique_seen(seen, value) == 0 {
            start := str_find(text, value)
            out = push(out, detection("det.credit_card.luhn", "payment_details", start, start + len(value), value, 0.99, "credit card candidate passed Luhn validation", "remove"))
            seen = push(seen, value)
        }
    i = i + 1
}
return out
}

func detection(detector_id, category, start, end, value, confidence, reason, suggested_action) {
    return {
        "detector_id": detector_id,
        "category": category,
        "span_start": start,
        "span_end": end,
        "matched_value_hash": value_hash(value),
        "confidence": confidence,
        "reason": reason,
        "suggested_action": suggested_action,
        "value": value
    }
}

func unique_seen(arr, value) {
    mut i := 0
    while i < len(arr) {
        if arr[i] == value {
            return 1
        }
    i = i + 1
}
return 0
}

func only_digits(value) {
    mut out := ""
    mut i := 0
    while i < len(value) {
        ch := substring(value, i, i + 1)
        if ch >= "0"&&ch <= "9" {
            out = out + ch
        }
    i = i + 1
}
return out
}

func digit_value(ch) {
    if ch == "0" {return 0}
    if ch == "1" {return 1}
    if ch == "2" {return 2}
    if ch == "3" {return 3}
    if ch == "4" {return 4}
    if ch == "5" {return 5}
    if ch == "6" {return 6}
    if ch == "7" {return 7}
    if ch == "8" {return 8}
    if ch == "9" {return 9}
    return 0
}

func luhn_valid(digits) {
    mut sum := 0
    mut alt := false
    mut i := len(digits) - 1
    while i >= 0 {
        d := digit_value(substring(digits, i, i + 1))
        if alt {
            d = d * 2
            if d > 9 {
                d = d - 9
            }
    }
sum = sum + d
alt = alt == false
i = i - 1
}
return sum % 10 == 0
}
