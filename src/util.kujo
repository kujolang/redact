export func truthy(v) {
    if type(v) == "bool" {
        return v
    }
if type(v) == "int" {
    return v != 0
}
if type(v) == "null" {
    return false
}
if type(v) == "string" {
    return v != ""
}
return true
}

export func list_includes(arr, value) {
    mut i := 0
    while i < len(arr) {
        if arr[i] == value {
            return true
        }
    i = i + 1
}
return false
}

export func get_or(dict, key, fallback) {
    if has_key(dict, key) == 1 {
        return dict[key]
    }
return fallback
}

export func lines_of(text) {
    raw := split(text, "\n")
    mut out := []
    mut i := 0
    while i < len(raw) {
        line := raw[i]
        if ends_with(line, "\r") {
            out = push(out, substring(line, 0, len(line) - 1))
        } else {
        out = push(out, line)
    }
i = i + 1
}
return out
}

export func read_text(path) {
    if file_exists(path) == false {
        return {"ok": false, "error": "file not found: " + path}
    }
if path_is_dir(path) {
    return {"ok": false, "error": "path is a directory: " + path}
}
mut loaded := ""
try {
    loaded = read_file(path)
} except err {
return {"ok": false, "error": "file is not valid UTF-8 or cannot be read: " + path}
}
if type(loaded) != "string" {
    return {"ok": false, "error": "file is not valid UTF-8 or cannot be read: " + path}
}
return {"ok": true, "text": loaded}
}

export func path_has_traversal(path) {
    if type(path) != "string" {
        return true
    }
normalized := replace(path, "\\", "/")
parts := split(normalized, "/")
mut i := 0
while i < len(parts) {
    if parts[i] == ".." {
        return true
    }
i = i + 1
}
return false
}

export func path_has_symlink_component(path) {
    if type(path) != "string"||path == "" {
        return false
    }
mut absolute := path
if starts_with(absolute, "/") == false {
    absolute = os_getcwd() + "/" + absolute
}
parts := split(absolute, "/")
mut current := ""
if starts_with(absolute, "/") {
    current = "/"
}
mut i := 0
while i < len(parts) {
    part := parts[i]
    if part != ""&&part != "." {
        if current == "" {
            current = part
        } else if current == "/" {
        current = current + part
    } else {
    current = current + "/" + part
}
mut is_link := false
try {
    is_link = path_is_symlink(current)
} except err {
is_link = false
}
if is_link&&current != "/tmp"&&current != "/var" {
    return true
}
}
i = i + 1
}
return false
}

export func validate_directory_target(path, label) {
    if path == ""||path == "/" {
        return {"ok": false, "error": label + " must be a specific directory path"}
    }
if path_has_traversal(path) {
    return {"ok": false, "error": label + " must not contain path traversal segments: " + path}
}
if path_has_symlink_component(path) {
    return {"ok": false, "error": label + " must not contain symbolic links: " + path}
}
if path_exists(path)&&path_is_dir(path) == false {
    return {"ok": false, "error": label + " is not a directory: " + path}
}
return {"ok": true}
}

export func append_text(path, content) {
    parent := parent_of(path)
    if parent != "" {
        ensure_dir(parent)
    }
append_file(path, content)
}

export func ensure_dir(path) {
    if path == ""||path == "." {
        return
    }
if path_is_dir(path) {
    return
}
parts := split(path, "/")
mut cur := ""
if starts_with(path, "/") {
    cur = "/"
}
mut i := 0
while i < len(parts) {
    part := parts[i]
    if part != ""&&part != "." {
        if cur == "/" {
            cur = "/" + part
        } else if cur == "" {
        cur = part
    } else {
    cur = cur + "/" + part
}
if path_is_dir(cur) == false {
    create_dir(cur)
}
}
i = i + 1
}
}

export func parent_of(path) {
    mut i := len(path) - 1
    while i >= 0 {
        if substring(path, i, i + 1) == "/" {
            return substring(path, 0, i)
        }
    i = i - 1
}
return ""
}

export func base_of(path) {
    mut i := len(path) - 1
    while i >= 0 {
        if substring(path, i, i + 1) == "/" {
            return substring(path, i + 1, len(path))
        }
    i = i - 1
}
return path
}

export func ext_of(path) {
    name := to_lower(base_of(path))
    mut i := len(name) - 1
    while i >= 0 {
        if substring(name, i, i + 1) == "." {
            return substring(name, i, len(name))
        }
    i = i - 1
}
return ""
}

export func content_hash(text) {
    return sha256(text)
}

export func value_hash(text) {
    return "sha256:" + sha256(text)
}

export func replace_all_text(text, needle, replacement) {
    if needle == "" {
        return text
    }
return replace(text, needle, replacement)
}

export func count_substr(text, needle) {
    if needle == "" {
        return 0
    }
return len(split(text, needle)) - 1
}

export func str_find_from(text, needle, start_at) {
    if needle == "" {
        return - 1
    }
if start_at >= len(text) {return - 1}
offset := index_of(substring(text, start_at, len(text)), needle)
if offset < 0 {
    return - 1
}
return start_at + offset
}

export func str_find(text, needle) {
    if needle == "" {return - 1}
    return index_of(text, needle)
}

export func json_line(obj) {
    return to_json(obj) + "\n"
}

export func unique_push(arr, value) {
    if list_includes(arr, value) {
        return arr
    }
return push(arr, value)
}

// Kujo 1.0 len(string) counts Unicode scalars. Base64 exposes exact UTF-8
// byte size without a filesystem round trip; the temporary encoding is bounded
// by the input being measured and is not retained.
export func utf8_size(text) {
    encoded := encode_base64(text)
    size := len(encoded) / 4 * 3
    if ends_with(encoded, "==") {return size - 2}
    if ends_with(encoded, "=") {return size - 1}
    return size
}

// Stable merge ordering preserves detector/category precedence on equal lengths.
export func longest_first(items, field) {
    if len(items) < 2 {return items}
    mut left := []
    mut right := []
    mut i := 0
    while i < len(items) {
        if i * 2 < len(items) {
            left = push(left, items[i])
        } else {
        right = push(right, items[i])
    }
i = i + 1
}
left = longest_first(left, field)
right = longest_first(right, field)
mut out := []
mut l := 0
mut r := 0
while l < len(left)&&r < len(right) {
    lv := left[l]
    rv := right[r]
    if field != "" {
        lv = lv[field]
        rv = rv[field]
    }
if len(lv) >= len(rv) {
    out = push(out, left[l])
    l = l + 1
} else {
out = push(out, right[r])
r = r + 1
}
}
while l < len(left) {
    out = push(out, left[l])
    l = l + 1
}
while r < len(right) {
    out = push(out, right[r])
    r = r + 1
}
return out
}

export func only_digits(value) {
    return regex_replace(value, "[^0-9]", "")
}
