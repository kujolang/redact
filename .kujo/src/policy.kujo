from src.util import lines_of, read_text, get_or

func default_categories() {
    return [
        "person_names",
        "company_names",
        "customer_names",
        "product_names",
        "emails",
        "phone_numbers",
        "payment_details",
        "api_keys",
        "domains",
        "exact_dates",
        "money_amounts",
        "launch_strategy"
    ]
}

func built_in_path(name) {
    return "policies/" + name + ".yaml"
}

export func load_policy(ref) {
    path := ref
    if file_exists(path) == false {
        path = built_in_path(ref)
    }
    loaded := read_text(path)
    if loaded["ok"] == false {
        return {"ok": false, "error": "policy not found: " + ref}
    }
    parsed := parse_policy_yaml(loaded["text"])
    if parsed["ok"] == false {
        return parsed
    }
    p := parsed["policy"]
    p["path"] := path
    p["raw"] := loaded["text"]
    return {"ok": true, "policy": p}
}

export func parse_policy_yaml(text) {
    mut policy := {
        "name": "unnamed",
        "preserve_task_structure": true,
        "write_entity_map": false,
        "ai_assist": false,
        "terms": {
            "person_names": [],
            "company_names": [],
            "customer_names": [],
            "product_names": [],
            "launch_strategy": []
        },
        "roles": {}
    }
    cats := default_categories()
    mut ci := 0
    while ci < len(cats) {
        policy[cats[ci]] := "placeholder"
        ci = ci + 1
    }
    policy["phone_numbers"] := "remove"
    policy["payment_details"] := "remove"
    policy["api_keys"] := "remove"
    policy["exact_dates"] := "date-generalize"
    policy["money_amounts"] := "range"
    policy["launch_strategy"] := "generalize"

    current_list := ""
    current_map := ""
    ls := lines_of(text)
    mut i := 0
    while i < len(ls) {
        raw := ls[i]
        line := trim(raw)
        if line != "" && starts_with(line, "#") == false {
            if starts_with(line, "- ") && current_list != "" {
                val := trim(substring(line, 2, len(line)))
                terms := policy["terms"]
                arr := get_or(terms, current_list, [])
                arr = push(arr, unquote(val))
                terms[current_list] := arr
                policy["terms"] := terms
            } else if contains(line, ":") == 1 {
                parts := split(line, ":")
                key := trim(parts[0])
                val := ""
                if len(parts) > 1 {
                    val = trim(substring(line, len(parts[0]) + 1, len(line)))
                }
                if key == "terms" {
                    current_list = ""
                    current_map = "terms"
                } else if key == "roles" {
                    current_list = ""
                    current_map = "roles"
                } else if val == "" {
                    current_list = normalize_term_key(key)
                    current_map = ""
                    terms2 := policy["terms"]
                    if has_key(terms2, current_list) == 0 {
                        terms2[current_list] := []
                        policy["terms"] := terms2
                    }
                } else if current_map == "roles" {
                    roles := policy["roles"]
                    roles[key] := unquote(val)
                    policy["roles"] := roles
                } else {
                    current_list = ""
                    current_map = ""
                    policy[key] := parse_scalar(val)
                }
            }
        }
        i = i + 1
    }
    if policy["name"] == "" {
        return {"ok": false, "error": "policy name is required"}
    }
    return {"ok": true, "policy": policy}
}

func normalize_term_key(key) {
    if key == "person_dictionary" {
        return "person_names"
    }
    if key == "company_dictionary" {
        return "company_names"
    }
    if key == "customer_dictionary" {
        return "customer_names"
    }
    if key == "product_dictionary" {
        return "product_names"
    }
    if key == "strategy_terms" {
        return "launch_strategy"
    }
    return key
}

func parse_scalar(val) {
    v := unquote(val)
    low := to_lower(v)
    if low == "true" {
        return true
    }
    if low == "false" {
        return false
    }
    return v
}

func unquote(v) {
    if len(v) >= 2 {
        first := substring(v, 0, 1)
        last := substring(v, len(v) - 1, len(v))
        if first == "\"" && last == "\"" {
            return substring(v, 1, len(v) - 1)
        }
        if first == "'" && last == "'" {
            return substring(v, 1, len(v) - 1)
        }
    }
    return v
}

export func policy_action(policy, category) {
    if has_key(policy, category) == 1 {
        return policy[category]
    }
    return "placeholder"
}

export func policy_terms(policy, category) {
    terms := policy["terms"]
    if has_key(terms, category) == 1 {
        return terms[category]
    }
    return []
}

export func policy_role(policy, value, fallback) {
    roles := policy["roles"]
    if has_key(roles, value) == 1 {
        return roles[value]
    }
    return fallback
}
